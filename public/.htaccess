# Apache (IONOS, most PHP hosts): files that exist are sent as they are
# (pictures already made, CSS, JS, fonts); everything else goes to index.php.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # The Next.js shop's picture addresses, served from the files already made (see index.php).
  RewriteCond %{DOCUMENT_ROOT}/media/$1/$2.webp -f
  RewriteRule ^api/img/([a-z0-9]+)/(\d+)$ media/$1/$2.webp [L]
  RewriteCond %{DOCUMENT_ROOT}/media/$1/$2.jpg -f
  RewriteRule ^api/img/([a-z0-9]+)/(\d+)$ media/$1/$2.jpg [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpg|woff2|css|js|svg|png)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

AddType image/webp .webp
AddType font/woff2 .woff2
